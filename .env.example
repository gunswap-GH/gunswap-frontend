# Reown (formerly WalletConnect) Cloud project ID — get one free at https://cloud.reown.com
# Required for the wallet modal and mobile QR-code connections.
# Copy this file to .env and fill it in.
VITE_REOWN_PROJECT_ID=

# RPC endpoints (comma-separated, first has priority; leave empty to fall back to a single official node).
VITE_BSC_RPCS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io,https://bsc-dataseed1.bnbchain.org

# Testnet RPC endpoints (comma-separated, first has priority; leave empty to fall back to a single official node).
VITE_BSC_TESTNET_RPCS=https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.binance.org:8545,https://data-seed-prebsc-2-s1.binance.org:8545,https://bsc-testnet.public.blastapi.io
